<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Camera Feature -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- لازم من أندرويد 11 فيما فوق عشان نقدر نشوف تطبيقات التعرف على الصوت المثبتة على الجهاز -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.My_VisionAssistAI"
        tools:targetApi="31">

        <!-- Splash / Main -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- Register -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Choose User -->
        <activity
            android:name=".ChooseUserActivity"
            android:exported="false" />

        <!-- Blind Dashboard -->
        <activity
            android:name=".BlindActivity"
            android:exported="false" />

        <!-- Guardian Dashboard -->
        <activity
            android:name=".GuardianActivity"
            android:exported="false" />

        <!-- Photo Reports -->
        <activity
            android:name=".PhotoReportActivity"
            android:exported="false" />

        <!-- OCR -->
        <activity
            android:name=".OCRActivity"
            android:exported="false" />

        <!-- Currency -->
        <activity
            android:name=".CurrencyActivity"
            android:exported="false" />

        <!-- Face Recognition -->

        <activity android:name=".FaceRecognitionActivity" android:exported="false" />

        <!-- Navigation -->
        <activity
            android:name=".NavigationActivity"
            android:exported="false" />

        <!-- SOS -->
        <activity
            android:name=".SOSActivity"
            android:exported="false" />

        <!-- Settings -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ObjectDetectionExternalActivity"
            android:exported="false" />

    </application>

</manifest>