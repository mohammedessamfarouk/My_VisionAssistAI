<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101828">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vision Assist AI"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="30sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blind Dashboard"
            android:textColor="#BDBDBD"
            android:textSize="18sp"
            android:layout_marginBottom="20dp"/>

        <!-- Detect Objects -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="15dp"
            app:cardBackgroundColor="#1B263B"
            app:cardCornerRadius="18dp">

            <Button
                android:id="@+id/btnObjects"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="📷 Detect Objects"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="20sp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Read Text -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="15dp"
            app:cardBackgroundColor="#1B263B"
            app:cardCornerRadius="18dp">

            <Button
                android:id="@+id/btnRead"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="📝 Read Text"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="20sp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Currency -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="15dp"
            app:cardBackgroundColor="#1B263B"
            app:cardCornerRadius="18dp">

            <Button
                android:id="@+id/btnMoney"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="💵 Detect Currency"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="20sp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recognize Person -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="15dp"
            app:cardBackgroundColor="#1B263B"
            app:cardCornerRadius="18dp">

            <Button
                android:id="@+id/btnFace"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="👤 Recognize Person"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="20sp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Navigation -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="15dp"
            app:cardBackgroundColor="#1B263B"
            app:cardCornerRadius="18dp">

            <Button
                android:id="@+id/btnNavigation"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="🗺 Navigation"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="20sp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Settings -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="15dp"
            app:cardBackgroundColor="#374151"
            app:cardCornerRadius="18dp">

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="⚙ Settings"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="20sp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- SOS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="15dp"
            app:cardBackgroundColor="#D32F2F"
            app:cardCornerRadius="18dp">

            <Button
                android:id="@+id/btnSOS"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="🚨 Emergency SOS"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="22sp"/>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>